[
  { "match": { "name": "Tennessee Quantum Hackathon", "city": "Chattanooga" },
    "action": "update",
    "reason": "Organiser event page https://thecompanylab.org/event/tennessee-quantum-hackathon/ reads '3 Days, 10 Teams, 1 City November 13 - 15, 2026 in Chattanooga, TN' and 'Venue The Max Fuller Center for Innovation and Entrepreneurship, The University of Tennessee at Chattanooga 601 McCallie Ave, Room 213 Chattanooga, 37403'. Start date was right; the stored end (Nov 13) came from the calendar plugin's single-day JSON-LD, and the stored venue '110 Somerville Ave' is CO.LAB's office address printed in the site footer, not where the hackathon runs.",
    "set": { "next_date_end": "2026-11-15", "venue": "The Max Fuller Center for Innovation and Entrepreneurship, University of Tennessee at Chattanooga, 601 McCallie Ave", "url": "https://thecompanylab.org/event/tennessee-quantum-hackathon/" } },
  { "match": { "name": "Seattle Day of Data", "city": "Seattle" },
    "action": "update",
    "reason": "Organiser event page https://dayofdata.org/2026-11-12-dayofdata1155/ body reads 'Event Date : 13 November 2026 This event is: in-person' and 'This is a free event', location 'Seattle Public Library, Auditorium 1000 4th Ave Seattle, WA 98101'. The site's source repo (github.com/sqlsaturday/dayofdata_website, _data/events/SQLSat1155.yml) has 'date: 2026-11-13' from organiser commit 2026-09-17 'changing date and location for seattle day of data'. The 2026-11-12 in the URL slug and on the dayofdata.org index is the stale post filename date (Jekyll), not the event date.",
    "set": { "next_date": "2026-11-13", "next_date_end": "2026-11-13", "venue": "Seattle Public Library, Auditorium, 1000 4th Ave", "cost": "free" } },
