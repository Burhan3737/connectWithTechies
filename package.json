{
  "name": "connectwithtechies",
  "version": "0.1.0",
  "private": true,
  "description": "A departures board for tech events across the United States and Canada.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build-data.mjs",
    "apply": "node scripts/apply-patches.mjs",
    "ledger": "node scripts/ledger.mjs",
    "stale": "node scripts/ledger.mjs --report",
    "refresh": "node scripts/build-data.mjs && node agent/tools/verify-dates.mjs --write && node scripts/ledger.mjs",
    "verify:dates": "node agent/tools/verify-dates.mjs",
    "check:data": "node agent/tools/check-data.mjs",
    "check:links": "node agent/tools/check-links.mjs",
    "start": "node scripts/serve.mjs",
    "test": "node scripts/smoke-test.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "jsdom": "^28.1.0"
  }
}
